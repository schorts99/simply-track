# Google Cloud OAuth web client ID (public, not a client secret).
# Enable Drive API and add your exact HTTPS origin (or http://localhost:3000).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Shown in /privacy and /terms. Leave empty to use neutral wording.
NEXT_PUBLIC_LEGAL_OPERATOR=
NEXT_PUBLIC_LEGAL_CONTACT=
NEXT_PUBLIC_LEGAL_JURISDICTION=
